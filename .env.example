APP_NAME=slate-api
ENVIRONMENT=development
# URL do Postgres (Supabase). Opcional nesta fase; a conexão entra na issue #2.
# Schema precisa ser "postgresql+asyncpg://" (driver explícito para create_async_engine).
# O dashboard do Supabase entrega "postgresql://" — edite o schema antes de colar.
DATABASE_URL=
# Segredo de validação do JWT do Supabase. Opcional nesta fase; entra na issue #8.
SUPABASE_JWT_SECRET=
# Pool do SQLAlchemy async. Defaults dimensionados para o free tier do Supabase:
# "Database Max Connections" 60 (conexão direta) e "Connection Pooler Max Clients" 200
# (Supavisor) — https://supabase.com/docs/guides/platform/compute-and-disk. Máx. de
# pool_size + max_overflow conexões por instância da API.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
# Transaction mode do Supavisor não suporta prepared statements do asyncpg; 0 desliga
# o cache. https://supabase.com/docs/guides/database/connecting-to-postgres
DB_STATEMENT_CACHE_SIZE=0
