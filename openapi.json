    "/commitments/{commitment_id}": {
      "delete": {
        "tags": [
          "commitments"
        ],
        "summary": "Delete Commitment",
        "description": "Sem `keep_paid`, apaga o commitment e todas as entries, inclusive as pagas.\n\n`keep_paid=true` é o cancelamento (preserva as pagas, remove as previstas), que\ndepende do motor de cancelamento e por ora responde 501 sem alterar nada.",
        "operationId": "delete_commitment_commitments__commitment_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "commitment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Commitment Id"
            }
          },
          {
            "name": "keep_paid",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Keep Paid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "501": {
            "description": "keep_paid=true ainda não implementado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
